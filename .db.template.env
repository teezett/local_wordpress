# Kopie dieser Datei nach .db.env, Werte anpassen. Werte OHNE Leerzeichen/Anfuehrungszeichen.

# --- Datenbank (wird von docker compose UND vom Makefile benutzt) ---
DB_USER=username
# Passwort z.B. aus dem MacOS-Schluesselbund holen und hier eintragen:
#   security find-generic-password -a username -s my-website-db -w
DB_PASS=password
DB_ROOT_PASS=rootpassword
DB_NAME=database_name
DB_PREFIX=wp_

# --- Live-Seite (wird beim Restore durch http://localhost:<WP_PORT> ersetzt) ---
PROD_URL=https://www.example.com

# --- Versionen: an die Live-Seite angleichen (steht im Kopf des Dumps) ---
WP_VERSION=6.8.1
PHP_VERSION=8.1
MYSQL_VERSION=8.0.41

# --- Optional ---
# Wo liegen die UpdraftPlus-Sicherungen? (fuer `make fetch-backups`)
#  a) Webspace per SSH:
#UPDRAFT_METHOD=rsync
#UPDRAFT_REMOTE=user@host:/pfad/zu/wp-content/updraft/
#  b) Google Drive u.a. per rclone (einmalig: brew install rclone && rclone config):
#UPDRAFT_METHOD=rclone
#UPDRAFT_REMOTE=gdrive:UpdraftPlus

# Bei mehreren Seiten gleichzeitig muessen die Ports pro Seite verschieden sein
#WP_PORT=8080
#DB_PORT=3306
#MAILPIT_PORT=8025
# Plugins, die auf Staging nicht laufen sollen (Backup, Cache, ...), durch Leerzeichen getrennt
DISABLE_PLUGINS=updraftplus
